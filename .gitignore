# ─── Secrets — never commit ───────────────────────────────────
.env
.env.local
.env.*

# MCP config contains hardcoded API tokens
.mcp.json

# Claude Code settings contain API tokens
.claude/settings.json
.claude/settings.local.json

# Google service account private key
credentials/

# Product-specific automation scripts (may contain credentials via .env)
scripts/*
# Generic utilities with no credentials — tracked
!scripts/lib/

# ─── Runtime & generated ──────────────────────────────────────
# Playwright MCP session logs
.playwright-mcp/

# QA session output — screenshots, logs, reports
qa-artifacts/

# Node
node_modules/

# macOS
.DS_Store
